# Server Configuration
PORT=5000
NODE_ENV=development

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs
STRIPE_MONTHLY_PRICE_ID=price_monthly_id_here
STRIPE_ANNUAL_PRICE_ID=price_annual_id_here

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Firebase Admin SDK Configuration
# Option 1: Using GOOGLE_APPLICATION_CREDENTIALS (Recommended - Most Reliable)
# Download your service account JSON file from Firebase Console and set the path:
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Option 2: Using Custom Environment Variables
# If you prefer to use individual environment variables:
FIREBASE_PROJECT_ID=your_firebase_project_id
# IMPORTANT: The private key must include the full key with proper formatting
# Copy the entire private key from Firebase Console, including BEGIN/END markers
# Example format (replace with your actual key):
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_service_account_email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=optional_private_key_id
FIREBASE_CLIENT_ID=optional_client_id

# Option 3: Using Service Account JSON File in config directory
# If you prefer to use a JSON file, place it in server/config/therapyforblkmen-firebase-adminsdk.json
# and remove the Firebase environment variables above
